# Environments
.venv/
env/
.installed

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool output
output/

# Snapshot archives of this repository — don't nest copies inside the original
_backup/

# Large raw volume data — not needed by the cut tool (it works from the mesh).
# The 138 MB .raw is the MHD volume used only for centerline *generation*.
*.raw

# OS cruft
.DS_Store
Thumbs.db

# Derived geometry and centerlines.
#
# These are NOT identifying on their own: a lumen surface carries no name, MRN,
# date or face, which is why public repositories such as the Vascular Model
# Repository publish them openly. Checked on the files already committed here --
# the .mat headers hold only a Simpleware creation timestamp, the MHD header only
# voxel geometry, and no variable name or field carries a patient identifier.
#
# They are ignored to keep the repository small and to leave the decision about
# which cases to publish an explicit one, not a side effect of `git add .`.
# What must never be committed is the source imaging: DICOM and .sip project
# files, which do carry identifiers.
JK5_1_M10.mat
JK5_1_CentrelinePoints_branches.csv
*_CentrelinePoints*.csv
*_M10.mat

# Test scratch output
tests/_out/
tests/out_*/

# Source imaging — these DO carry identifiers. Never commit.
*.sip
*.dcm
dicom/
dicom_sip/
sip/

# Screenshots the browser checks drop beside themselves
tests/web/*.png

# Built distributions
dist/

# Cohort roots are local to a machine and point at lab shares
tools/cohorts.local.json
tools/bench_*.jsonl
tools/nub_*.jsonl

# Figures and per-run tables from the CAMP sweeps. Regenerated in seconds from
# camp_noise.jsonl, and the interactive plotly copies are ~4.7 MB EACH because
# each embeds its own plotly bundle. The measurement record itself is kept (see
# below) -- it is what took the time; a PNG of it did not.
tools/camp_nubs_*
tools/camp_cohort_final_*
tools/*.html

# ...but NOT camp_noise.jsonl. 180 CAMP runs, about 40 minutes, 100 KB. It is the
# evidence behind the trim and the repair decisions, and every later claim is
# checkable against it without re-running anything. Committed on purpose.
!tools/camp_noise.jsonl
# the anatomy benchmark's own history: useful locally, noise in review
tools/anat_bench*.jsonl

# Zone renders, galleries and per-run option sweeps. All of it is rebuilt from the
# cohort by zone_map.py, zone_gallery.py, zone_score_shots.py and zone_stub_pairs.py,
# and it comes to about 20 MB. What is NOT regenerable is tools/zone_marks.json --
# a person clicking a boundary onto 167 vertices by hand -- so that one is committed.
tools/zone_map_*/
tools/zone_gallery_*/
tools/zone_marks_*/
tools/zone_opts/
tools/zone_*.png
# zone_bench_*.jsonl is NOT caught by the tools/bench_*.jsonl rule above: that
# pattern needs the name to START with bench_.
tools/zone_bench_*.jsonl

# CAMP intermediates. Pickles, and large: .camp_matched.pkl alone is 12.9 MB. A
# pickle executes arbitrary code when it loads, which is not a thing to hand someone
# through a clone; these rebuild from camp_noise.jsonl, which IS committed.
tools/.camp_*.pkl
tools/.camp_*.npy
tools/.thumb_cache/

# Working files written by subagents during an investigation. Nothing here is a
# deliverable; the conclusions live in tools/ZONES.md.
scratch_wf/

# The paper's rendered figures. Kept out on purpose -- a figure goes in only when it
# has been approved, which means `git add -f` on the one figure, deliberately.
docs/figures/*.png
docs/*.pdf
Figure_1.png

# A collaborator's patient-derived meshes and centerlines (KK16_6, 2 Oct 2026), kept
# here to work on. Source data, not code: it never goes to GitHub.
ZF_Example/
