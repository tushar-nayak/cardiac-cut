# Keep line endings correct per-platform regardless of who commits from where.
* text=auto
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf
*.py   text eol=lf

# Treat data, images, and documents as binary (no line-ending or diff munging).
*.mat  binary
*.csv  binary
*.png  binary
*.pdf  binary
*.raw  binary
